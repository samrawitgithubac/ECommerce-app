# PostgreSQL connection
DATABASE_URL=postgresql://ecommerce:12345@localhost:5432/ecommercedb

# Server
PORT=3000
JWT_SECRET=your_jwt_secret_here
APP_BASE_URL=http://localhost:3000

# Demo mode: true = simulate payments without Stripe (default if no Stripe key)
DEMO_MODE=true

# Stripe test keys (optional – free at https://dashboard.stripe.com/test/apikeys)
# Use test card 4242 4242 4242 4242 – no real money
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# Google Cloud Translation API (https://console.cloud.google.com/apis/library/translate.googleapis.com)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
